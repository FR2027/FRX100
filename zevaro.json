  </main>

  <!-- 頁尾 Footer -->
  <footer class="w-full py-6 border-t border-white/5 text-center text-[11px] font-mono text-muted flex flex-col sm:flex-row justify-between items-center px-8 space-y-2 sm:space-y-0">
    <div>© 2026 Zevaro Search Inc. All rights reserved.</div>
    <div class="flex space-x-6">
