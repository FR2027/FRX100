  <!-- Firebase Modular SDK Script -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { getAuth, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
    import { getDatabase, ref, set, push, onValue, remove } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

    // Firebase 配置項目
    const firebaseConfig = {
      apiKey: "AIzaSyB4HCJ5-yVSZ6HYo-4wu5OzZz6v3l-zXTw",
      authDomain: "zevaro-22ee0.firebaseapp.com",
      databaseURL: "https://zevaro-22ee0-default-rtdb.firebaseio.com/",
      projectId: "zevaro-22ee0",
      storageBucket: "zevaro-22ee0.firebasestorage.app",
      messagingSenderId: "615259169523",
      appId: "1:615259169523:web:8cd369f1f82c00ee3acd86",
      measurementId: "G-3YX4CRJW6V"
    };

    // 初始化 Firebase
    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getDatabase(app);
    const provider = new GoogleAuthProvider();

    let currentUser = null;
    let allSites = [];
    let savedSiteIds = new Set();
    let currentCategory = 'All';

    // 預設精選宣傳網站數據（若數據庫尚無資料時使用）
    const initialPromotions = [
      {
        id: 'promo-frx',
        name: 'FRX Official',
        url: 'https://frx-tau.vercel.app/',
        category: 'Design',
        description: '極致的高冷黑奢 UI 設計與前沿技術整合平台。',
        featured: true,
        created_at: Date.now()
      },
      {
        id: 'promo-github',
        name: 'GitHub Infrastructure',
        url: 'https://github.com',
        category: 'Developer',
        description: '全球最大的代碼託管與開發者協作平台。',
        featured: false,
        created_at: Date.now() - 100000
      },
      {
        id: 'promo-vercel',
        name: 'Vercel Cloud Platform',
        url: 'https://vercel.com',
        category: 'Developer',
        description: '專為前端開發者與 Next.js 設計的極速部署雲端服務。',
        featured: true,
        created_at: Date.now() - 200000
      }
    ];

    // 初始化與監聽 Firebase 數據庫中的網站列表
    function initDatabase() {
      const sitesRef = ref(db, 'promotions');
      onValue(sitesRef, (snapshot) => {
        const data = snapshot.val();
        if (data) {
          allSites = Object.keys(data).map(key => ({ id: key, ...data[key] }));
        } else {
          // 初始化填入預設網站
          initialPromotions.forEach(site => {
            push(ref(db, 'promotions'), site);
          });
        }
        renderResults();
      });
    }

    // AuthState 監聽
    onAuthStateChanged(auth, (user) => {
      currentUser = user;
      const btnLogin = document.getElementById('btn-login');
      const userProfile = document.getElementById('user-profile');

      if (user) {
        btnLogin.classList.add('hidden');
        userProfile.classList.remove('hidden');
        document.getElementById('user-avatar').src = user.photoURL || 'https://via.placeholder.com/150';
        document.getElementById('user-name').innerText = user.displayName || user.email;

        // 讀取用戶的歷史與收藏
        loadUserHistory();
        loadUserBookmarks();
      } else {
        btnLogin.classList.remove('hidden');
        userProfile.classList.add('hidden');
        savedSiteIds.clear();
        renderResults();
      }
    });

    // 登入功能
    window.loginWithGoogle = async () => {
      try {
        await signInWithPopup(auth, provider);
      } catch (error) {
        console.error("Login failed:", error);
      }
    };

    // 登出功能
    window.logout = async () => {
      await signOut(auth);
    };

    // 搜尋功能與寫入歷史
    window.executeSearch = () => {
      const query = document.getElementById('search-input').value.trim();
      if (query && currentUser) {
        // 將歷史寫入 Firebase
        const historyRef = ref(db, `users/${currentUser.uid}/history`);
        push(historyRef, {
          query: query,
          timestamp: Date.now()
        });
      }
      hideHistoryDropdown();
      renderResults();
    };

    window.handleSearch = () => {
      renderResults();
    };

    // 讀取搜尋歷史
    function loadUserHistory() {
      if (!currentUser) return;
      const historyRef = ref(db, `users/${currentUser.uid}/history`);
      onValue(historyRef, (snapshot) => {
        const data = snapshot.val();
        const historyList = document.getElementById('history-list');
        historyList.innerHTML = '';

        if (data) {
          const items = Object.values(data).reverse().slice(0, 5); // 取最新5筆
          items.forEach(item => {
            const div = document.createElement('div');
            div.className = 'px-2 py-1.5 hover:bg-white/5 rounded text-xs font-mono text-gray-300 cursor-pointer flex items-center justify-between';
            div.innerHTML = `<span><i class="fa-regular fa-clock text-muted mr-2"></i>${item.query}</span>`;
            div.onclick = () => {
              document.getElementById('search-input').value = item.query;
              executeSearch();
            };
            historyList.appendChild(div);
          });
        } else {
          historyList.innerHTML = '<div class="text-xs text-muted px-2 py-1">無搜尋紀錄</div>';
        }
      });
    }

    // 清除歷史紀錄
    window.clearHistory = () => {
      if (currentUser) {
        remove(ref(db, `users/${currentUser.uid}/history`));
      }
    };

    // 提交網站上架
    window.handleSiteSubmit = async (e) => {
      e.preventDefault();
      const name = document.getElementById('sub-name').value;
      const url = document.getElementById('sub-url').value;
      const category = document.getElementById('sub-cat').value;
      const description = document.getElementById('sub-desc').value;
      const featured = document.getElementById('sub-promo').checked;

      const newSite = {
        name,
        url,
        category,
        description,
        featured,
        created_at: Date.now(),
        submitted_by: currentUser ? currentUser.uid : 'anonymous'
      };

      await push(ref(db, 'promotions'), newSite);
      closeModal('submit-modal');
      document.getElementById('submit-form').reset();
      alert('✅ 網站提交成功！已即時發布至 Zevaro 搜尋引擎。');
    };

    // 收藏/取消收藏網站
    window.toggleBookmark = (siteId) => {
      if (!currentUser) {
        alert('請先使用 Google 登入以使用收藏功能。');
        return;
      }

      const bookmarkRef = ref(db, `users/${currentUser.uid}/bookmarks/${siteId}`);
      if (savedSiteIds.has(siteId)) {
        remove(bookmarkRef);
      } else {
        set(bookmarkRef, true);
      }
    };

    function loadUserBookmarks() {
      if (!currentUser) return;
      const bookmarksRef = ref(db, `users/${currentUser.uid}/bookmarks`);
      onValue(bookmarksRef, (snapshot) => {
        const data = snapshot.val() || {};
        savedSiteIds = new Set(Object.keys(data));
        renderResults();
        renderBookmarksModal();
      });
    }

    // 渲染搜尋結果
    function renderResults() {
      const query = document.getElementById('search-input').value.toLowerCase().trim();
      const container = document.getElementById('results-container');
      container.innerHTML = '';

      const filtered = allSites.filter(site => {
        const matchQuery = !query || 
          site.name.toLowerCase().includes(query) ||
          site.url.toLowerCase().includes(query) ||
          site.description.toLowerCase().includes(query);
        
        const matchCategory = currentCategory === 'All' || site.category === currentCategory;

        return matchQuery && matchCategory;
      });

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="text-center py-16 text-muted font-mono text-xs">
            未找到相關的宣傳網站。<br>
            <button onclick="openModal('submit-modal')" class="text-white underline mt-2">點此提交您的網站</button>
          </div>
        `;
        return;
      }

      filtered.forEach(site => {
        const isSaved = savedSiteIds.has(site.id);
        const card = document.createElement('div');
        card.className = 'site-card cold-glass rounded-xl p-5 flex flex-col justify-between space-y-3';
        card.innerHTML = `
          <div class="flex items-start justify-between">
            <div class="space-y-1">
              <div class="flex items-center space-x-2">
                <a href="${site.url}" target="_blank" class="text-base font-semibold text-white hover:underline flex items-center space-x-1.5">
                  <span>${site.name}</span>
                  <i class="fa-solid fa-arrow-up-right-from-square text-[10px] text-muted"></i>
                </a>
                ${site.featured ? '<span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/10 text-gray-300 border border-white/20">PROMOTED</span>' : ''}
              </div>
              <div class="text-xs font-mono text-muted/80">${site.url}</div>
            </div>
            
            <button onclick="toggleBookmark('${site.id}')" class="text-muted hover:text-yellow-400 transition p-1">
              <i class="${isSaved ? 'fa-solid text-yellow-400' : 'fa-regular'} fa-star text-sm"></i>
            </button>
          </div>

          <p class="text-xs text-gray-300 line-clamp-2 leading-relaxed">
            ${site.description}
          </p>

          <div class="flex items-center justify-between text-[11px] font-mono text-muted pt-2 border-t border-white/5">
            <span class="px-2 py-0.5 rounded bg-white/5">${site.category}</span>
            <a href="${site.url}" target="_blank" class="hover:text-white transition">開啟網站 →</a>
          </div>
        `;
        container.appendChild(card);
      });
    }

    // 渲染收藏 Modal
    function renderBookmarksModal() {
      const list = document.getElementById('bookmarks-list');
      list.innerHTML = '';

      const bookmarkedSites = allSites.filter(site => savedSiteIds.has(site.id));

      if (bookmarkedSites.length === 0) {
        list.innerHTML = '<div class="text-xs text-muted font-mono py-8 text-center">尚未收藏任何網站</div>';
        return;
      }

      bookmarkedSites.forEach(site => {
        const div = document.createElement('div');
        div.className = 'p-3 cold-glass rounded-lg border border-white/5 flex items-center justify-between';
        div.innerHTML = `
          <div>
            <a href="${site.url}" target="_blank" class="text-xs font-medium text-white hover:underline">${site.name}</a>
            <div class="text-[10px] font-mono text-muted">${site.url}</div>
          </div>
          <button onclick="toggleBookmark('${site.id}')" class="text-xs text-red-400 hover:text-red-300 px-2 py-1">移除</button>
        `;
        list.appendChild(div);
      });
    }

    // 分類選取
    window.filterCategory = (cat) => {
      currentCategory = cat;
      document.querySelectorAll('.cat-btn').forEach(btn => {
        if (btn.innerText.includes(cat) || (cat === 'All' && btn.innerText === '全部')) {
          btn.className = 'cat-btn active px-3 py-1.5 rounded-full border border-white/20 bg-white text-black transition';
        } else {
          btn.className = 'cat-btn px-3 py-1.5 rounded-full border border-white/10 text-muted hover:border-white/30 hover:text-white transition';
        }
      });
      renderResults();
    };

    // UI 控制 Modal
    window.openModal = (id) => document.getElementById(id).classList.remove('hidden');
    window.closeModal = (id) => document.getElementById(id).classList.add('hidden');

    window.showHistoryDropdown = () => {
      if (currentUser) document.getElementById('history-dropdown').classList.remove('hidden');
    };
    window.hideHistoryDropdown = () => {
      setTimeout(() => document.getElementById('history-dropdown').classList.add('hidden'), 200);
    };

    window.resetSearch = () => {
      document.getElementById('search-input').value = '';
      filterCategory('All');
    };

    // 初始化資料庫
    initDatabase();
  </script>
</body>
</html>
