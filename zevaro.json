  <!-- Modal 2: 我的收藏網站列表 -->
  <div id="bookmarks-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md fade-in">
    <div class="cold-glass w-full max-w-lg rounded-2xl p-6 border border-white/10 relative max-h-[80vh] flex flex-col">
      <button onclick="closeModal('bookmarks-modal')" class="absolute top-4 right-4 text-muted hover:text-white transition">
