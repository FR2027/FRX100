  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { getAuth, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
    import { getDatabase, ref, onValue, runTransaction } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

    // Firebase 設定
    const firebaseConfig = {
      apiKey: "AIzaSyB4HCJ5-yVSZ6HYo-4wu5OzZz6v3l-zXTw",
      authDomain: "zevaro-22ee0.firebaseapp.com",
      databaseURL: "https://zevaro-22ee0-default-rtdb.firebaseio.com/",
      projectId: "zevaro-22ee0",
      storageBucket: "zevaro-22ee0.firebasestorage.app",
      messagingSenderId: "615259169523",
      appId: "1:615259169523:web:8cd369f1f82c00ee3acd86",
      measurementId: "G-3YX4CRJW6V"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getDatabase(app);
    const provider = new GoogleAuthProvider();

    // 您的 GitHub RAW 網址
    const GITHUB_RAW_URL = "https://raw.githubusercontent.com/FR2027/FRX100/refs/heads/main/zevaro.json";

    let allSites = [];
    let siteAnalytics = {};
    let currentUser = null;
    let activeFilter = 'all';

    // 1. 初始化讀取 GitHub RAW 資料與 Firebase 點擊計數
    async function initEngine() {
      try {
        const res = await fetch(GITHUB_RAW_URL);
        if (res.ok) {
          allSites = await res.json();
        }
      } catch (e) {
        console.error("無法載入 GitHub RAW 網域資料", e);
      }

      // 監聽 Firebase 上的點擊效益數據 (analytics/{site_id}/clicks)
      const analyticsRef = ref(db, 'analytics');
      onValue(analyticsRef, (snapshot) => {
        siteAnalytics = snapshot.val() || {};
        renderSearchResults();
        if (currentUser) checkOwnerAccess(currentUser);
      });
    }

    // 2. AuthState 狀態變更 (Google 登入監聽)
    onAuthStateChanged(auth, (user) => {
      currentUser = user;
      const btnLogin = document.getElementById('btn-login');
      const userProfile = document.getElementById('user-profile');
      const btnDashboard = document.getElementById('btn-dashboard');

      if (user) {
        btnLogin.classList.add('hidden');
        userProfile.classList.remove('hidden');
        document.getElementById('user-avatar').src = user.photoURL || 'https://via.placeholder.com/150';
        
        // 檢查該用戶的 Gmail 是否在 GitHub RAW 中擁有網站
        checkOwnerAccess(user);
      } else {
        btnLogin.classList.remove('hidden');
        userProfile.classList.add('hidden');
        btnDashboard.classList.add('hidden');
        switchTab('search');
      }
    });

    window.loginWithGoogle = async () => {
      try {
        await signInWithPopup(auth, provider);
      } catch (e) {
        console.error("Google 登入失敗", e);
      }
    };

    window.logout = async () => {
      await signOut(auth);
    };

    // 3. 檢查當前登入的 Gmail 是否符合 RAW 中的 owner_email
    function checkOwnerAccess(user) {
      const userEmail = user.email.toLowerCase();
      // 比對 RAW 中的 owner_email
      const ownedSites = allSites.filter(site => site.owner_email && site.owner_email.toLowerCase() === userEmail);
      
      const btnDashboard = document.getElementById('btn-dashboard');
      if (ownedSites.length > 0) {
        // 擁有網站 -> 顯示「站長效益管理」按鈕
        btnDashboard.classList.remove('hidden');
        document.getElementById('dashboard-user-info').innerText = `已授權帳號: ${user.email} (找到 ${ownedSites.length} 個綁定網域)`;
        renderDashboard(ownedSites);
      } else {
        // 沒有對應網站 -> 隱藏後台按鈕
        btnDashboard.classList.add('hidden');
      }
    }

    // 4. 點擊網址並累加效益數據 (Firebase 交易安全計數)
    window.recordClick = (siteId, siteUrl) => {
      const clickRef = ref(db, `analytics/${siteId}/clicks`);
      runTransaction(clickRef, (currentClicks) => {
        return (currentClicks || 0) + 1;
      });
      window.open(siteUrl, '_blank');
    };

    // 5. 渲染網址搜尋結果
    window.renderSearchResults = () => {
      const query = document.getElementById('search-input').value.toLowerCase().trim();
      const container = document.getElementById('results-list');
      container.innerHTML = '';

      const filtered = allSites.filter(site => {
        const matchQuery = !query || 
          site.name.toLowerCase().includes(query) ||
          site.url.toLowerCase().includes(query) ||
          site.description.toLowerCase().includes(query) ||
          (site.category && site.category.toLowerCase().includes(query));

        let matchFilter = true;
        if (activeFilter === 'trending') matchFilter = site.is_trending;
        if (activeFilter === 'sponsored') matchFilter = site.is_sponsored;

        return matchQuery && matchFilter;
      });

      if (filtered.length === 0) {
        container.innerHTML = `<div class="text-center py-12 text-muted font-mono text-xs">未找到符合條件的網域或網站。</div>`;
        return;
      }

      filtered.forEach(site => {
        const clicks = (siteAnalytics[site.id] && siteAnalytics[site.id].clicks) || 0;
        const card = document.createElement('div');
        card.className = 'site-card cold-glass rounded-xl p-5 flex flex-col md:flex-row md:items-center justify-between space-y-4 md:space-y-0';
        
        card.innerHTML = `
          <div class="flex items-start space-x-4">
            <img src="${site.logo}" onerror="this.src='https://via.placeholder.com/48/0d0e12/ffffff?text=Z'" class="w-12 h-12 rounded-lg border border-white/10 object-cover bg-surface">
            <div>
              <div class="flex items-center space-x-2 flex-wrap gap-y-1">
                <h3 class="text-base font-semibold text-white">${site.name}</h3>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 text-muted border border-white/10">${site.category || 'Domain'}</span>
                ${site.is_trending ? '<span class="text-[10px] font-mono px-2 py-0.5 rounded bg-red-500/10 text-red-400 border border-red-500/20">🔥 熱搜網域</span>' : ''}
                ${site.is_sponsored ? '<span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">🚀 推廣中</span>' : ''}
              </div>
              <div class="text-xs font-mono text-muted mt-1 select-all">${site.url}</div>
              <p class="text-xs text-gray-300 mt-2 line-clamp-2">${site.description}</p>
            </div>
          </div>

          <div class="flex items-center space-x-4 justify-end font-mono text-xs">
            <div class="text-right text-muted hidden md:block">
              <div>全網點擊: <span class="text-white">${clicks}</span></div>
              <div class="text-[10px] text-muted/60">擁有者: ${site.owner_email}</div>
            </div>
            <button onclick="recordClick('${site.id}', '${site.url}')" class="cold-btn px-4 py-2 rounded-lg font-medium text-xs">
              訪問網站 →
            </button>
          </div>
        `;
        container.appendChild(card);
      });
    };

    // 6. 渲染站長專屬效益管理面板
    function renderDashboard(ownedSites) {
      const listContainer = document.getElementById('owner-sites-list');
      listContainer.innerHTML = '';

      let totalClicks = 0;
      document.getElementById('stat-my-sites').innerText = ownedSites.length;

      ownedSites.forEach(site => {
        const clicks = (siteAnalytics[site.id] && siteAnalytics[site.id].clicks) || 0;
        totalClicks += clicks;

        const card = document.createElement('div');
        card.className = 'cold-glass p-5 rounded-xl flex flex-col md:flex-row justify-between items-start md:items-center space-y-3 md:space-y-0';
        card.innerHTML = `
          <div class="flex items-center space-x-4">
            <img src="${site.logo}" class="w-10 h-10 rounded-lg border border-white/10 object-cover bg-surface">
            <div>
              <div class="text-sm font-semibold text-white flex items-center space-x-2">
                <span>${site.name}</span>
                ${site.is_sponsored ? '<span class="text-[10px] bg-amber-500/10 text-amber-400 px-1.5 py-0.2 rounded border border-amber-500/20 font-mono">已購買推廣</span>' : ''}
              </div>
              <div class="text-xs font-mono text-muted mt-0.5">${site.url}</div>
            </div>
          </div>
          
          <div class="flex items-center space-x-8 font-mono text-xs w-full md:w-auto justify-between md:justify-end border-t md:border-t-0 pt-3 md:pt-0 border-white/5">
            <div class="text-right">
              <div class="text-muted text-[10px]">累計導流效益</div>
              <div class="text-emerald-400 font-bold text-sm">${clicks} Clicks</div>
            </div>
            <button onclick="window.open('${site.url}', '_blank')" class="cold-btn px-3 py-1.5 rounded text-xs">
              預覽網站
            </button>
          </div>
        `;
        listContainer.appendChild(card);
      });

      document.getElementById('stat-my-clicks').innerText = totalClicks;
    }

    // UI 切換控制
    window.switchTab = (tab) => {
      if (tab === 'dashboard') {
        if (!currentUser) {
          alert('請先使用 Google 登入驗證您的站長身份。');
          return;
        }
      }
      document.getElementById('view-search').classList.toggle('hidden', tab !== 'search');
      document.getElementById('view-dashboard').classList.toggle('hidden', tab !== 'dashboard');
    };

    window.setFilter = (filter) => {
      activeFilter = filter;
      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.className = 'filter-btn px-3 py-1.5 rounded-full border border-white/10 text-muted hover:text-white';
      });
      document.getElementById(`btn-filter-${filter}`).className = 'filter-btn px-3 py-1.5 rounded-full border border-white/20 bg-white text-black';
      renderSearchResults();
    };

    // 啟動引擎
    initEngine();
  </script>
</body>
</html>
