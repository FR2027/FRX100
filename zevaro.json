          <label class="block text-muted font-mono mb-1">分類 (Category)</label>
          <select id="sub-cat" class="w-full cold-input p-3 rounded-lg text-white bg-bg">
            <option value="Developer">開發者工具 (Developer)</option>
            <option value="AI">AI 應用 (AI)</option>
            <option value="Design">設計美學 (Design)</option>
            <option value="Productivity">生產力 (Productivity)</option>
            <option value="Other">其他 (Other)</option>
          </select>
        </div>
        <div>
          <label class="block text-muted font-mono mb-1">宣傳簡介 (Description)</label>
          <textarea id="sub-desc" rows="3" required placeholder="請簡述您的網站優勢與特色..." class="w-full cold-input p-3 rounded-lg text-white"></textarea>
        </div>
        <div class="flex items-center space-x-2 pt-2">
          <input type="checkbox" id="sub-promo" class="rounded bg-bg border-white/20">
          <label for="sub-promo" class="text-muted">申請全網推廣標籤 (Featured Badge)</label>
